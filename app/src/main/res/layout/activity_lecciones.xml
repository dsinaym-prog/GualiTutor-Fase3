<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="#F4F6FB">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MIS LECCIONES" android:textSize="26sp" android:textStyle="bold" android:textColor="#243B73" android:gravity="center"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lecciones disponibles de programación en Java" android:gravity="center" android:layout_marginBottom="15dp"/>
    <TextView android:id="@+id/estadoLecciones" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cargando..." android:padding="8dp"/>
    <ListView android:id="@+id/listaLecciones" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <Button android:id="@+id/btnActualizarLecciones" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Actualizar lista" android:backgroundTint="#6750A4"/>
    <Button android:id="@+id/btnVolver" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Volver al inicio" android:backgroundTint="#6750A4"/>
</LinearLayout>
